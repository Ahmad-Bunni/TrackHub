{
  "private": true,
  "main": "main/index.js",
  "name": "track-hub",
  "author": "TimeBridge",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "icon": "main/hub.ico",
  "scripts": {
    "clean": "rimraf dist main renderer/out",
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && electron .\"",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build-renderer": "vite build",
    "build-electron": "tsc -p ./electron-src/tsconfig.json",
    "build": "bun run build-renderer && bun run build-electron",
    "postbuild": "bunx prisma generate --schema=prisma/schema.prisma",
    "pack-app": "bun run build && bunx electron-builder --dir",
    "dist": "bun run build && bunx electron-builder",
    "type-check": "bunx tsc -p ./renderer/tsconfig.json && bunx tsc -p ./electron-src/tsconfig.json",
    "validate": "bun run type-check && bun run build-renderer && echo 'All checks passed'",
    "agent-check": "node scripts/agent-check.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toast": "^1.2.19",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "lucide-react": "^1.25.0",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.19",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.timebridge.trackhub",
    "productName": "TrackHub",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/.prisma/**/*",
      "**/node_modules/@prisma/**/*",
      "**/node_modules/better-sqlite3/**/*"
    ],
    "icon": "hub.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main",
      "renderer/out",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
